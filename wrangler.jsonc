{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "covervote",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  // Attached to the shared hostname by path-scoped Routes, NOT a Custom Domain
  // — the `games` hub Worker holds that. Cloudflare matches the most-specific
  // route first, so these peel /covervote off the hub.
  // Two patterns: `/*` does not match the bare prefix, and the bare prefix is
  // what worker/index.js redirects to the trailing-slash form.
  "routes": [
    { "pattern": "games.csiesheep.com/covervote", "zone_name": "csiesheep.com" },
    { "pattern": "games.csiesheep.com/covervote/*", "zone_name": "csiesheep.com" }
  ],
  // Only public/ is uploaded as static assets (tools/build_public.mjs builds it).
  // The site lives in public/covervote/, so asset paths equal URLs and are served
  // without running the Worker; only the bare prefix runs it first (for the redirect).
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/covervote"]
  }
}
