{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "covervote",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  // Attached to the shared hostname by path-scoped Routes, NOT a Custom Domain
  // — the `games` hub Worker holds that. Cloudflare matches the most-specific
  // route first, so these peel /covervote off the hub.
  // Two patterns: `/*` does not match the bare prefix, and the bare prefix is
  // what worker/index.js redirects to the trailing-slash form.
  "routes": [
    { "pattern": "games.csiesheep.com/covervote", "zone_name": "csiesheep.com" },
    { "pattern": "games.csiesheep.com/covervote/*", "zone_name": "csiesheep.com" }
  ],
  // Only public/ is uploaded as static assets (tools/build_public.mjs builds it).
  // The site lives in public/covervote/, so asset paths equal URLs and are served
  // without running the Worker; only the bare prefix (for the redirect) and the API run it first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/covervote", "/covervote/api/*"]
  },
  // Rate limit for POST /covervote/api/guess and /play (issue #32; worker/api.mjs `limited`).
  // Keyed by CF-Connecting-IP; the IP goes to this binding only (Cloudflare's transient per-location counter),
  // never to D1 or logs. 300 per 60 s (orchestrator 裁決 #32: 「同意 limit 300/period 60，只在 wrangler.jsonc 一處」):
  // a class of 30 behind one school NAT sends 60 POSTs in the minute the teacher says 開票. period must be 10 or 60.
  // namespace_id is an account-wide integer chosen by us; no other csiesheep Worker uses ratelimits today.
  "ratelimits": [
    { "name": "POST_LIMITER", "namespace_id": "3201", "simple": { "limit": 300, "period": 60 } }
  ],
  // Aggregate counters for /covervote/api/* (worker/api.mjs, worker/d1store.mjs).
  // Creating the database is a deploy step and belongs to the orchestrator: create it,
  // paste its id here, then `wrangler d1 migrations apply covervote --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "covervote",
      "database_id": "bec24308-3642-4731-aa66-19910e3c2c76",
      "migrations_dir": "migrations"
    }
  ]
}
